# RecoverAI — Razorpay Test-Mode credentials
#
# Copy this file to `.env` (or export these as real environment variables)
# and fill in YOUR OWN Test Mode keys from the Razorpay Dashboard.
#
# NEVER commit a real .env file. NEVER paste real values into source code,
# documentation, or a chat/AI assistant. This file only exists to document
# the required variable NAMES — it intentionally contains no real secret.

# Get these from: Razorpay Dashboard -> toggle to TEST MODE -> Account & Settings
# -> API Keys -> Generate Key. The key_id must start with "rzp_test_".
RAZORPAY_KEY_ID=rzp_test_your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Safety switch. Defaults to "true" (no network call made) even if this line
# is absent. Only set to "false" once you intentionally want this integration
# to make a real Razorpay TEST MODE API call (Payment Links only — see
# razorpay_client.py). This must never be set to "false" with a live-mode key;
# razorpay_config.py refuses live keys unconditionally regardless of this flag.
RECOVERAI_RAZORPAY_DRY_RUN=true
